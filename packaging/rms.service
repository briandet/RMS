# systemd unit for RMS.  Installed by packaging/install.sh; settings live in /etc/default/rms.
# To let RMS write outside its data directory (e.g. a playlist folder), run
# `sudo systemctl edit rms` and add:  [Service]  ReadWritePaths=/path/to/playlists

[Unit]
Description=RMS music server
Documentation=https://github.com/rustydc/RMS
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rms
Group=rms
StateDirectory=rms
Environment=RMS_DATA_DIR=/var/lib/rms
EnvironmentFile=-/etc/default/rms
ExecStart=/usr/local/bin/rms
Restart=on-failure
RestartSec=5

# Hardening: read-only system and home directories, writable /var/lib/rms only
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
# no devices but the GPU's (the TV visualiser draws and encodes on it; install.sh puts the
# rms user in the render and video groups)
DevicePolicy=closed
DeviceAllow=char-drm rw
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
